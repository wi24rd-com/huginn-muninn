{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Huginn and Muninn",
  "version": "1.0.0",
  "identifier": "com.wi24rd.huginn-muninn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Wi24rd Huginn and Muninn",
        "url": "index.html",
        "width": 1200,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 17 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Jan Tingsvad",
    "shortDescription": "Wi24rd Huginn and Muninn — for Cloudflare®",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Huginn-Muninn.entitlements"
    }
  }
}
