{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hovedvinduet: kernens standardrettigheder minus core:tray:default og core:menu:default (webvisningen kan hverken ændre menulinjeikonet eller erstatte programmenuen; begge bygges i Rust), plus core:window:allow-start-dragging (båndet øverst er vinduets trækbare titellinje, titleBarStyle Overlay), og appens egne kommandoer. Ingen fs, shell, http, opener, tray, menu, autostart:* eller notification:* (start ved login går gennem autostart_hent/autostart_saet; notifikationer sendes og klik håndteres i Rust; Hent nu går gennem hent_nu; et klik på et CVE-nummer går gennem aabn_cve, som kun åbner cve.org i brugerens browser; kildelinjen under Radar-tal går gennem aabn_radar, som kun åbner radar.cloudflare.com; Åbn vejledningen går gennem aabn_vejledning, som kun åbner faste adresser på wi24rd.com).",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "allow-token-set",
    "allow-token-status",
    "allow-token-delete",
    "allow-zones",
    "allow-zones-cache",
    "allow-vaern-cache",
    "allow-vaern-oversigt",
    "allow-kortdata",
