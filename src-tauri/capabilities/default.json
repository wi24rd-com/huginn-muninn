    "allow-valg-hent",
    "allow-domaener-hent",
    "allow-domaener-saet",
    "allow-domaene-afvis",
    "allow-vaern-samlet-cache",
    "allow-dyk",
    "allow-robotter",
    "allow-besoegende",
    "allow-login",
    "allow-login-stier",
    "allow-login-sti-saet",
    "allow-login-sti-fjern",
    "allow-trafik-dag",
    "allow-teknologi-hent",
    "allow-teknologi-saet",
    "allow-teknologi-alle",
    "allow-teknologi-side",
    "allow-teknologi-vis-saet",
